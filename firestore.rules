rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "58fjgMCI2aV7NQpXo3TcReUjHRF3";
    }

    function userMap() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function ownsStudent(studentId) {
      return signedIn() && (
        request.auth.uid == studentId ||
        userMap().studentId == studentId
      );
    }

    match /config/aparencia {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{document=**} {
      allow read, write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /studio/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Slots de reposição: qualquer autenticado lê; cria se livre e for o próprio aluno
    match /bookedSlots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.studentUid is string
        && ownsStudent(request.resource.data.studentUid);
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.studentUid != null && ownsStudent(resource.data.studentUid));
    }

    match /students/__system_courses {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || ownsStudent(studentId) || (
        signedIn() &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email
      );
      // Admin full write; student may merge counter/status fields on own doc
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || ownsStudent(studentId);

      match /exercises/{exerciseId} {
        allow read: if isAdmin() || ownsStudent(studentId);
        allow create, update: if isAdmin() || ownsStudent(studentId);
        allow delete: if isAdmin();
      }

      match /reportCards/{cardId} {
        allow read: if isAdmin() || ownsStudent(studentId);
        allow write: if isAdmin();
      }

      match /diario/{entryId} {
        allow read: if isAdmin() || ownsStudent(studentId);
        allow create: if isAdmin() || ownsStudent(studentId);
        allow update: if isAdmin() || ownsStudent(studentId);
        allow delete: if isAdmin();
      }

      match /calendarEvents/{eventId} {
        allow read, create, update: if isAdmin() || ownsStudent(studentId);
        allow delete: if isAdmin() || ownsStudent(studentId);
      }

      match /notifications/{notifId} {
        allow read, update: if isAdmin() || ownsStudent(studentId);
        allow create: if isAdmin() || ownsStudent(studentId);
        allow delete: if isAdmin();
      }

      match /{document=**} {
        allow read: if isAdmin() || ownsStudent(studentId);
        allow write: if isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /invoices/{document=**} {
      allow read, write: if isAdmin();
    }

    match /transactions/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
